<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="v1-create-cart_items-table" author="Anton_Ivanov">
        <preConditions onFail="CONTINUE" onFailMessage="Table cart_items already exist">
            <not>
                <tableExists tableName="cart_items"/>
            </not>
        </preConditions>

        <createTable tableName="cart_items">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="cart_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="cart_items" baseColumnNames="cart_id"
                                 constraintName="cart_id_fk"
                                 referencedTableName="carts"
                                 referencedColumnNames="id"
        />

        <rollback>
            <dropTable tableName="cart_items"/>
        </rollback>
    </changeSet>

</databaseChangeLog>